# ============================================================================
# VARIABLES DE ENTORNO - POLLERÍA GERSON
# ============================================================================
# Copiar este archivo a .env.local (desarrollo) o .env.production (producción)
# y llenar con los valores reales.

# ============================================================================
# BASE DE DATOS (PostgreSQL externo - NO en Google Cloud)
# ============================================================================
# Usar su PostgreSQL existente (Neon, AWS RDS, Azure, local, etc.)
# IMPORTANTE: sslmode=require es obligatorio para conexiones externas seguras
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_db?sslmode=require"

# URL directa para migraciones (puede ser la misma o sin pooler)
DIRECT_DATABASE_URL="postgresql://usuario:password@host:5432/nombre_db?sslmode=require"

# ============================================================================
# AUTENTICACIÓN (JWT)
# ==========================================================================
# Cambiar esta clave en producción por una segura y aleatoria
JWT_SECRET="cambiar-por-una-clave-segura-y-aleatoria-en-produccion"

# ============================================================================
# APLICACIÓN
# ==========================================================================
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL="https://su-dominio.com"

# ============================================================================
# LOGGING (Opcional - Grafana Loki)
# ==========================================================================
# LOKI_URL=http://loki:3100